# ===== Aegis Rover Command - settings (edit here, then restart run.bat) =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
UNIT_ID=GLOVEDRIVE-ESP32-01

# Hotspot the ESPs join (used by tools/apply_wifi.py to patch the firmware)
WIFI_SSID=AiPoweredCam
WIFI_PASS=your-hotspot-password
HUB_HOST=192.168.137.1

# Alert thresholds
GAS_WARN_RAW=1500
GAS_DANGER_RAW=2500
RSSI_MIN_DBM=-80
SILENT_AFTER_S=3
ALERT_COOLDOWN_S=30

# Timing
DB_LOG_INTERVAL_S=1
CAM_POLL_INTERVAL_S=1

# Optional fallback camera snapshot/stream URL if not connecting ESP32-CAM via WebSocket
# CAMERA_STREAM_URL=http://192.168.137.100/capture
